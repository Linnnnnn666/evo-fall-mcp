# EvoAgent fall-mcp 环境变量模板
# 复制为 .env 并填写真实值（生产环境由 systemd EnvironmentFile 注入；容器化由 compose env_file 注入）

# MQTT 凭据（mosquitto，需 ACL 允许 fall/# 通配）
MQTT_USER=YOUR_MQTT_USER
MQTT_PASS=YOUR_MQTT_PASSWORD

# 语音服务员推送鉴权（xiaozhi-server POST /api/push）
FALL_APP_TOKEN=YOUR_FALL_APP_TOKEN

# 设备注册 token（telemetry API）
DEVICE_TOKEN=YOUR_DEVICE_TOKEN

# DeepSeek / DashScope（DSH 任务用）
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY

# 服务器地址（容器化时指向 xiaozhi-server 服务）
SERVER_HOST=YOUR_SERVER_HOST

# MCP 端点（默认 127.0.0.1:8002；host 网络下即宿主端口）
MCP_HOST=127.0.0.1
MCP_PORT=8002
